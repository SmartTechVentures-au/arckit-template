# Copy to .env BEFORE reopening in the container. Rebuild after changing it.
# Docker --env-file syntax: KEY=value, no export, shell expansion or quotes.
# Values may contain spaces, # and = literally. One variable per line.
# Uncomment only variables you want to set. Never commit .env.

# Optional API-key authentication; account login is also available in each CLI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CURSOR_API_KEY=

# Optional Git identity and GitHub CLI token (also used by Git's gh helper).
# GIT_USERNAME=Your Name
# GIT_EMAIL=you@example.com
# GH_TOKEN=

# Optional Azure DevOps CLI token.
# AZURE_DEVOPS_EXT_PAT=

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
ARCKIT_PROFILE=development
ARCKIT_TEMPLATES_DIR=.arckit/templates
