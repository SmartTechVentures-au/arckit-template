# Environment Configuration
# Copy this file to .env and update with your values.

# AI Settings
# API keys are read from your HOST environment and forwarded into the
# container by .devcontainer/devcontainer.json. Export them in your shell
# before launching VS Code (they do not need to live in this file).
#   export ANTHROPIC_API_KEY=sk-ant-...
#   export OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# Python configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Optional ArcKit configuration
ARCKIT_PROFILE=development
ARCKIT_TEMPLATES_DIR=.arckit/templates

GIT_USERNAME=YOUR_GIT_USERNAME
GIT_EMAIL=YOUR_GIT_EMAIL
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

AZDO_USERNAME=YOUR_AZDO_USERNAME
AZDO_PAT=YOUR_AZDO_PAT